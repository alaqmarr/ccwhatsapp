# ==============================================================================
# Classic Concepts WhatsApp Desk (whatsapp.ccapl.cc) - Production Environment
# PM2 Process Name: ccwhatsapp | Port: 3007
# Copy this file to `.env.production` in the root of `ccwhatsapp/` on your VPS.
# ==============================================================================

NODE_ENV="production"
PORT="3007"
APP_URL="https://whatsapp.ccapl.cc"

# Optional override if running outside the repo directory (auto-set by PM2 ecosystem.config.cjs)
# CCWHATSAPP_ROOT="/var/www/ccwhatsapp"

# ------------------------------------------------------------------------------
# 1. Ecosystem Catalog & Website Enquiry Sync (Classic Concepts + Classic Edge 53)
# Tip: If classicconcepts runs on the same VPS (e.g. port 3003), you can use
# http://127.0.0.1:3003 for zero-latency local catalog & enquiry sync.
# Sibling folders ../classicconcepts/dev.db and ../classicedge/dev.db are also auto-detected.
# ------------------------------------------------------------------------------
CLASSICCONCEPTS_API_URL="https://www.classicconcepts.in"
CLASSICEDGE_API_URL="https://www.classicedge53.com"
CLASSIC_CONCEPTS_MAIN_DB=""
CLASSIC_EDGE_MAIN_DB=""

# ------------------------------------------------------------------------------
# 2. Redis Cache (100MB Ceiling, DB /1 so classicconcepts DB /0 stays isolated)
# Automatically falls back to built-in 100MB in-memory LRU cache if Redis is offline.
# ------------------------------------------------------------------------------
REDIS_URL="redis://127.0.0.1:6379/1"
REDIS_MAXMEMORY_BYTES="104857600"
REDIS_DISABLED="0"

# ------------------------------------------------------------------------------
# 3. ACRIO AI Key (Strictly locked to claude-haiku-5-5)
# One Anthropic key works everywhere. Can be set here, saved in the web UI,
# or auto-shared from a sibling ../classicconcepts installation.
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=""
ANTHROPIC_ADMIN_API_KEY=""
ANTHROPIC_CLIENT_API_KEY=""

# ------------------------------------------------------------------------------
# 4. Outbound Email OTP & Team Approval Notifications (SMTP)
# Leave blank to use built-in preview OTP codes during initial onboarding.
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Classic Concepts WhatsApp Desk <noreply@classicconcepts.in>"

# ------------------------------------------------------------------------------
# Note: Meta WhatsApp Cloud API credentials (WABA ID, Phone Number ID, App Secret,
# System User Token, Webhook Verify Token) and Midnight IST Google Drive Backups
# are configured directly in the web UI at /setup and /dashboard/dev.
# ------------------------------------------------------------------------------
