# ==============================================================================
# Classic Concepts Customer & Order Desk (chat.ccapl.cc) - Production Environment
# PM2 Process Name: ccwhatsapp | Port: 3007
# Copy this file to `.env.production` in the root of `ccwhatsapp/` on your VPS.
# ==============================================================================

NODE_ENV="production"
PORT="3007"
APP_URL="https://chat.ccapl.cc"
TRACKING_PUBLIC_ORIGIN="https://track.ccapl.cc"
SEED_DEMO_DATA="0"

# 1. Dual-Agent ACRIO Anthropic Keys (Strictly locked to claude-haiku-5-5)
ANTHROPIC_CLIENT_API_KEY=""
ANTHROPIC_ADMIN_API_KEY=""

# 2. Meta WhatsApp Cloud API Credentials
WHATSAPP_MODE="LIVE_META_CLOUD"
META_BUSINESS_PORTFOLIO_ID=""
WHATSAPP_WABA_ID=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_DISPLAY_PHONE="+91 73372 20568"
WHATSAPP_VERIFIED_NAME="Classic Concepts Acrylic Private Limited"
WHATSAPP_SYSTEM_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN="cc_whatsapp_verify_2026"
META_APP_ID=""
META_APP_SECRET=""

# 3. Ecosystem Catalog & Website Enquiry Sync
CLASSICCONCEPTS_API_URL="https://www.classicconcepts.in"
CLASSICEDGE_API_URL="https://www.classicedge53.com"
CLASSIC_CONCEPTS_MAIN_DB=""
CLASSIC_EDGE_MAIN_DB=""

# 4. Redis Cache (100MB Ceiling, isolated DB /1)
REDIS_URL="redis://127.0.0.1:6379/1"
REDIS_MAXMEMORY_BYTES="104857600"
REDIS_DISABLED="0"

# 5. Outbound Email OTP & Team Approval Notifications (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Classic Concepts WhatsApp Desk <noreply@classicconcepts.in>"
