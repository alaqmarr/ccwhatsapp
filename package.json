{
  "name": "ccwhatsapp-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Classic Concepts Modular WhatsApp Business API Staff, CRM, ACRIO AI & Dev Operations Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace @cc/web run dev",
    "build": "npm --workspace @cc/web run build",
    "start": "npm --workspace @cc/web run start -- -p 3007",
    "typecheck": "npm --workspace @cc/web run typecheck",
    "lint": "node scripts/lint.js",
    "test:e2e": "tsx local-tests/run-e2e-tests.ts",
    "db:reset": "bash reset-db.sh",
    "pm2:start": "pm2 start ecosystem.config.cjs --update-env"
  },
  "dependencies": {
    "@libsql/client": "^0.15.4",
    "@tanstack/react-query": "^5.108.0",
    "@tanstack/react-virtual": "^3.14.26",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.41.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "nodemailer": "^7.0.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.2"
  }
}
